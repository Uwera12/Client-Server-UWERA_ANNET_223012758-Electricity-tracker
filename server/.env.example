# Copy this file to ".env" and fill in your values (never commit .env).

# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase dashboard -> Connect -> "Session pooler" connection string (works over IPv4).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

DJANGO_SECRET_KEY=change-me-to-any-long-random-string
DJANGO_DEBUG=True
# Where the Next.js client runs (for CORS)
CLIENT_ORIGIN=http://localhost:3000
